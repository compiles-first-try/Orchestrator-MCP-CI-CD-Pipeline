# Database
DATABASE_URL=postgres://rpa:rpa@localhost:5432/rpa_platform

# Encryption (AES-256-GCM key, 32 bytes base64-encoded)
PLATFORM_ENCRYPTION_KEY=

# Orchestrator MCP — defaults to local mock for dev
ORCHESTRATOR_MCP_URL=http://mock-orchestrator-mcp:4000
ORCHESTRATOR_REST_BASE_URL=

# Default OAuth2 client credentials (used only for local seeding)
DEFAULT_OAUTH_CLIENT_ID=
DEFAULT_OAUTH_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# GitHub
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# API
API_PORT=3000
LOG_LEVEL=info
