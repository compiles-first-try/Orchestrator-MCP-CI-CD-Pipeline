# ---- Database ----
DATABASE_URL=postgres://rpa:rpa@localhost:5432/rpa_platform

# ---- Encryption ----
PLATFORM_ENCRYPTION_KEY=esI

# ---- UiPath Orchestrator (your real tenant — used as `dev`) ----
ORCHESTRATOR_REST_BASE_URL=https://cloud.uipath.com/nickajeipkd/Nick_PC/orchestrator_
ORCHESTRATOR_MCP_URL=http://mock-orchestrator-mcp:4000

# Default OAuth values are unused at the platform level — per-tenant creds
# are captured via the `/rpa tenant connect` modal. Leave blank.
