# ---- Database ----
DATABASE_URL=postgres://rpa:rpa@localhost:5432/rpa_platform

# ---- Encryption ----
PLATFORM_ENCRYPTION_KEY=esI

# ---- UiPath Orchestrator (your real tenant — used as `dev`) ----
ORCHESTRATOR_REST_BASE_URL=https://cloud.uipath.com/nickajeipkd/Nick_PC/orchestrator_
ORCHESTRATOR_MCP_URL=http://mock-orchestrator-mcp:4000

# Default OAuth values are unused at the platform level — per-tenant creds
# are captured via the `/rpa tenant connect` modal. Leave blank.
DEFAULT_OAUTH_CLIENT_ID=
DEFAULT_OAUTH_CLIENT_SECRET=

# ---- Slack ----
SLACK_BOT_TOKEN=xox
SLACK_SIGNING_SECRET=c8f
SLACK_APP_TOKEN=A0B
RPA_SLACK_CHANNEL_ID=C0B

# ---- GitHub ----
GITHUB_PLATFORM_TOKEN=ghp

# Optional GitHub App webhook plumbing — leave blank for now
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ---- Framework template repo ----
RPA_TEMPLATE_REPO_OWNER=compiles-first-try
RPA_TEMPLATE_REPO_NAME=reframework-base-template
RPA_PROJECT_REPO_OWNER=compiles-first-try

# ---- API + bot processes ----
API_PORT=3000
API_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# ---- CI/CD Pipeline — per-tenant OAuth2 External App credentials ----
# Register one External Application per tenant in UiPath Orchestrator Admin.
# Grant Application Scopes: OR.Assets, OR.Folders, OR.Queues, OR.Buckets, OR.Execution, OR.Administration
ORCHESTRATOR_BASE_URL=https://cloud.uipath.com/{org}/{tenant}/orchestrator_
ORCHESTRATOR_IDENTITY_URL=https://cloud.uipath.com/{org}/identity_/connect/token
ORCHESTRATOR_SCOPES=OR.Assets OR.Folders OR.Queues OR.Buckets OR.Execution OR.Administration

ORCHESTRATOR_DEV_CLIENT_ID=
ORCHESTRATOR_DEV_CLIENT_SECRET=
ORCHESTRATOR_TEST_CLIENT_ID=
ORCHESTRATOR_TEST_CLIENT_SECRET=
ORCHESTRATOR_STAGE_CLIENT_ID=
ORCHESTRATOR_STAGE_CLIENT_SECRET=
ORCHESTRATOR_PROD_CLIENT_ID=
ORCHESTRATOR_PROD_CLIENT_SECRET=
