DEFAULT_OAUTH_CLIENT_SECRET=

# ---- Slack ----
SLACK_BOT_TOKEN=xox
SLACK_SIGNING_SECRET=c8f
SLACK_APP_TOKEN=A0B
RPA_SLACK_CHANNEL_ID=C0B

# ---- GitHub ----
GITHUB_PLATFORM_TOKEN=ghp

# Optional GitHub App webhook plumbing — leave blank for now
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ---- Framework template repo ----
RPA_TEMPLATE_REPO_OWNER=compiles-first-try
RPA_TEMPLATE_REPO_NAME=reframework-base-template
RPA_PROJECT_REPO_OWNER=compiles-first-try

# ---- API + bot processes ----
