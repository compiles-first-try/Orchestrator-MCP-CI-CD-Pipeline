{
  "name": "@rpa-platform/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/start.ts",
    "start": "node dist/start.js"
  },
  "dependencies": {
    "@rpa-platform/credential-source": "workspace:*",
    "@rpa-platform/db": "workspace:*",
    "@rpa-platform/orchestrator-client": "workspace:*",
    "@rpa-platform/reconciler": "workspace:*",
    "@rpa-platform/shared": "workspace:*",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.0",
    "pino": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^2.0.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  }
}
