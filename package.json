{
  "name": "rpa-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Slack-first internal platform for UiPath RPA development. Git-driven, audit-trailed, role-gated.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx infra/seed.ts",
    "sim:commit": "node -e \"const t=process.argv[1]||'dev';fetch('http://localhost:4100/sim-commit?tenant='+t,{method:'POST'}).then(r=>r.text()).then(console.log)\"",
    "init-template": "tsx tools/init-template-repo/src/init.ts",
    "viz": "tsx tools/process-viz/src/cli.ts",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:dry-run": "DEPLOY_MODE=dry-run tsx scripts/deploy.ts"
  },
  "devDependencies": {
    "@rpa-platform/db": "workspace:*",
    "@rpa-platform/orchestrator-client": "workspace:*",
    "@rpa-platform/shared": "workspace:*",
    "@types/node": "^20.14.10",
    "glob": "^11.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.0",
    "turbo": "^2.0.6",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2",
    "@vitest/coverage-v8": "^2.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
