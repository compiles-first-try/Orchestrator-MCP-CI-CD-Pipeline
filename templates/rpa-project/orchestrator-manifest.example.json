{
  "project": "MyAutomation",
  "folderPath": "Shared",
  "assets": [
    {
      "name": "MyAutomation_Environment",
      "type": "text",
      "value": "Development",
      "description": "Current environment name",
      "perEnvironment": {
        "dev": "Development",
        "test": "Test",
        "stage": "Staging",
        "prod": "Production"
      }
    },
    {
      "name": "MyAutomation_MaxRetries",
      "type": "integer",
      "value": 3,
      "description": "Maximum retry attempts"
    },
    {
      "name": "MyAutomation_IsEnabled",
      "type": "bool",
      "value": true
    }
  ],
  "queues": [
    {
      "name": "MyAutomation_WorkItems",
      "description": "Queue for incoming work items",
      "maxRetries": 2,
      "autoRetry": true,
      "uniqueReference": true
    }
  ],
  "buckets": [
    {
      "name": "MyAutomation_Output",
      "description": "Output files from the automation"
    }
  ],
  "packages": [
    {
      "path": "output/*.nupkg",
      "autoVersion": true
    }
  ],
  "libraries": [],
  "processes": [
    {
      "name": "MyAutomation",
      "packageId": "MyAutomation",
      "description": "Main automation process"
    }
  ]
}
